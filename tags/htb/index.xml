&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;| http://ha.ckers.org/slowloris/
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;|_ https://cve.mitre.org/cgi-bin/cvename.cgi?name&lt;span style="color:#f92672"&gt;=&lt;/span&gt;CVE-2007-6750
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;| http-enum: 
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;| /register/: Potentially interesting folder
